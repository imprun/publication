{
  "name": "@imprun/publication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend-first Windforce App for publishing Markdown to multiple platforms",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "marked": "16.0.0",
    "playwright": "1.60.0",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "25.0.10",
    "@types/sanitize-html": "2.16.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
