{
  "name": "@imprun/publication",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend-first Windforce App for publishing Markdown and HTML to multiple platforms",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "e2e:tistory-login": "npm run build && node dist/scripts/tistory-login-e2e.js",
    "format": "biome format --write .",
    "lint": "biome check .",
    "manifest": "npm run build && node dist/scripts/generate-manifest.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@imprun/app-sdk": "https://codeload.github.com/imprun/app-sdk/tar.gz/73ac0070a30f0a60bcb6fffc717917a5116c2634",
    "marked": "16.0.0",
    "puppeteer-core": "25.7.0",
    "sanitize-html": "2.17.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@types/node": "25.0.10",
    "@types/sanitize-html": "2.16.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
