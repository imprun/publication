{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["postId", "expectedTitle"],
  "properties": {
    "provider": { "const": "tistory", "default": "tistory" },
    "connectionId": { "const": "default", "default": "default" },
    "postId": { "type": "string", "pattern": "^\\d+$" },
    "expectedTitle": { "type": "string", "minLength": 1, "maxLength": 250 }
  }
}
