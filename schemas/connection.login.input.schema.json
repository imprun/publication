{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["blogHost"],
  "properties": {
    "provider": { "const": "tistory", "default": "tistory" },
    "connectionId": { "const": "default", "default": "default" },
    "blogHost": {
      "type": "string",
      "pattern": "^(?:https://)?[a-z0-9][a-z0-9-]{0,62}\\.tistory\\.com/?$"
    },
    "accountId": { "type": "string", "minLength": 1, "writeOnly": true }
  }
}
