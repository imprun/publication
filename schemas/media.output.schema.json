{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "connectionId",
    "filename",
    "mimeType",
    "size",
    "width",
    "height",
    "attachmentRef",
    "substitution"
  ],
  "properties": {
    "provider": { "const": "tistory" },
    "connectionId": { "const": "default" },
    "filename": { "type": "string" },
    "mimeType": {
      "enum": ["image/png", "image/jpeg", "image/gif", "image/webp"]
    },
    "size": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "attachmentRef": { "type": "string", "pattern": "^kage@" },
    "substitution": { "type": "string", "pattern": "^\\[##_Image\\|" }
  }
}
