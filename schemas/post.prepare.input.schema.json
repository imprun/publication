{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "content"],
  "properties": {
    "provider": { "const": "tistory", "default": "tistory" },
    "connectionId": { "const": "default", "default": "default" },
    "title": { "type": "string", "minLength": 1, "maxLength": 250 },
    "content": { "$ref": "#/$defs/content" },
    "tags": {
      "type": "array",
      "maxItems": 30,
      "default": [],
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "categoryId": { "type": "integer", "minimum": 0, "default": 0 }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "body"],
      "properties": {
        "format": { "enum": ["markdown", "html"] },
        "body": { "type": "string", "minLength": 1, "maxLength": 2000000 }
      }
    }
  }
}
