# Use fixture only for local UI development. Production must use cloud.
VITE_PUBLICATION_API_MODE=cloud
# Optional defaults. When omitted, the signed-in user selects a Cloud target.
# VITE_PUBLICATION_CLOUD_BASE_URL=https://your-tenant.cloud.imprun.dev
# VITE_PUBLICATION_CLOUD_WORKSPACE=default
VITE_IMPRUN_IDENTITY_AUTHORITY=https://identity.imprun.dev
VITE_IMPRUN_IDENTITY_CLIENT_ID=publication-console
VITE_IMPRUN_IDENTITY_AUDIENCE=imprun-api
VITE_IMPRUN_IDENTITY_SCOPE=openid profile email offline_access
